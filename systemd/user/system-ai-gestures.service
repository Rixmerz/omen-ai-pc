[Unit]
Description=system-ai gesture controller (webcam hand tracking)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/system-ai-gestures
Restart=on-failure
RestartSec=5s
Nice=10
# NO auto-enable — privacidad. Iniciar manualmente:
#   systemctl --user start system-ai-gestures.service
