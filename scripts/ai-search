#!/usr/bin/env python3
"""
ai-search — búsqueda semántica sobre journal/notas locales con nomic-embed.
Index incremental en sqlite.

Uso:
  ai-search index               # actualiza índice journal últimas 24h
  ai-search "wifi se cae"       # query semántica
  ai-search --explain "..."     # query + LLM resume top hits
"""
from __future__ import annotations
import argparse
import hashlib
import json
import sqlite3
import struct
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

OLLAMA_URL = "http://127.0.0.1:11434/api"
EMBED_MODEL = "nomic-embed-text"
CHAT_MODEL = "qwen2.5-coder:7b-instruct-q4_K_M"
DB = Path.home() / ".local/share/system-ai/search.db"
DB.parent.mkdir(parents=True, exist_ok=True)


def db_conn() -> sqlite3.Connection:
    c = sqlite3.connect(DB)
    c.execute("CREATE TABLE IF NOT EXISTS docs (id TEXT PRIMARY KEY, ts INTEGER, src TEXT, text TEXT, emb BLOB)")
    c.execute("CREATE INDEX IF NOT EXISTS docs_ts ON docs(ts)")
    return c


def embed(text: str) -> list[float]:
    body = {"model": EMBED_MODEL, "prompt": text[:8000]}
    req = urllib.request.Request(OLLAMA_URL + "/embeddings", data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read())["embedding"]


def to_blob(v: list[float]) -> bytes:
    return struct.pack(f"{len(v)}f", *v)


def from_blob(b: bytes) -> list[float]:
    return list(struct.unpack(f"{len(b)//4}f", b))


def cosine(a: list[float], b: list[float]) -> float:
    s = sum(x*y for x, y in zip(a, b))
    na = sum(x*x for x in a) ** 0.5
    nb = sum(x*x for x in b) ** 0.5
    return s / (na * nb + 1e-9)


def index_journal(hours: int = 24) -> int:
    c = db_conn()
    since = f"{hours} hours ago"
    r = subprocess.run(["journalctl", "--since", since, "--no-pager", "-o", "short-iso"], capture_output=True, text=True, timeout=60)
    added = 0
    for line in r.stdout.splitlines():
        if not line.strip() or line.startswith("--"):
            continue
        # bucket lines by minute+unit-ish via prefix hash
        h = hashlib.sha1(line.encode()).hexdigest()[:16]
        if c.execute("SELECT 1 FROM docs WHERE id=?", (h,)).fetchone():
            continue
        try:
            e = embed(line)
        except Exception as ex:
            print(f"embed fail: {ex}", file=sys.stderr)
            break
        c.execute("INSERT INTO docs(id,ts,src,text,emb) VALUES (?,?,?,?,?)",
                  (h, int(time.time()), "journal", line, to_blob(e)))
        added += 1
        if added % 50 == 0:
            c.commit()
            print(f"  +{added}", flush=True)
    c.commit()
    return added


def search(q: str, k: int = 8) -> list[tuple[float, str, str]]:
    qe = embed(q)
    c = db_conn()
    rows = c.execute("SELECT text, src, emb FROM docs").fetchall()
    scored = [(cosine(qe, from_blob(emb)), text, src) for text, src, emb in rows]
    scored.sort(key=lambda x: -x[0])
    return scored[:k]


def explain(q: str, hits: list[tuple[float, str, str]]) -> None:
    ctx = "\n".join(f"- [{src}, score={s:.2f}] {t}" for s, t, src in hits)
    prompt = f"Pregunta: {q}\n\nResultados top:\n{ctx}\n\nResumí en español, 4 líneas máx, qué dicen estos resultados y conclusión accionable."
    body = {"model": CHAT_MODEL, "messages": [{"role": "user", "content": prompt}], "stream": True, "options": {"temperature": 0.2}}
    req = urllib.request.Request(OLLAMA_URL + "/chat", data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=180) as r:
        for line in r:
            line = line.strip()
            if not line:
                continue
            try:
                ch = json.loads(line)
            except Exception:
                continue
            t = ch.get("message", {}).get("content", "")
            if t:
                sys.stdout.write(t); sys.stdout.flush()
            if ch.get("done"):
                sys.stdout.write("\n"); break


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("query", nargs="*")
    ap.add_argument("--explain", action="store_true")
    ap.add_argument("--hours", type=int, default=24)
    ap.add_argument("-k", type=int, default=8)
    args = ap.parse_args()
    cmd = " ".join(args.query).strip()
    if cmd == "index":
        n = index_journal(args.hours)
        print(f"indexed {n} entries (window {args.hours}h)")
        return 0
    if not cmd:
        print("uso: ai-search index | ai-search '<query>' | ai-search --explain '<q>'", file=sys.stderr)
        return 2
    hits = search(cmd, args.k)
    if args.explain:
        explain(cmd, hits)
    else:
        for s, t, src in hits:
            print(f"[{s:.3f}] {src}: {t[:200]}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
