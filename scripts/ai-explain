#!/usr/bin/env python3
"""
ai-explain — pipe input al LLM, resume causa/explicación.
Uso:
  journalctl -p err -n 50 | ai-explain
  ai-explain --boot
  ai-explain --service ollama
  systemd-analyze critical-chain | ai-explain
"""
from __future__ import annotations
import argparse
import json
import subprocess
import sys
import urllib.request

OLLAMA_URL = "http://127.0.0.1:11434/api/chat"
MODEL = "qwen2.5-coder:7b-instruct-q4_K_M"

SYSTEM = """Analizá el texto que recibís (logs, errores, output de comandos). Respondé en español, máximo 6 líneas. Estructura:
- **Resumen:** 1 frase qué pasa.
- **Causa probable:** 1-2 líneas.
- **Acción sugerida:** 1 comando concreto o 'investigar manualmente'.
Sin disclaimers. Sin saludos. Si el input está vacío o ininteligible, decí 'sin datos útiles'."""


def fetch_input(args: argparse.Namespace) -> str:
    if args.boot:
        return subprocess.run(["journalctl", "-b", "-p", "err", "--no-pager"], capture_output=True, text=True, timeout=10).stdout
    if args.service:
        return subprocess.run(["journalctl", "-u", args.service, "-n", "100", "--no-pager"], capture_output=True, text=True, timeout=10).stdout
    if not sys.stdin.isatty():
        return sys.stdin.read()
    return ""


def ask(text: str) -> int:
    if not text.strip():
        print("(sin input)", file=sys.stderr)
        return 2
    text = text[-16000:]  # truncar para context budget
    body = {
        "model": MODEL,
        "messages": [{"role": "system", "content": SYSTEM}, {"role": "user", "content": text}],
        "stream": True,
        "options": {"temperature": 0.2, "num_ctx": 8192},
    }
    req = urllib.request.Request(OLLAMA_URL, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=180) as r:
            for line in r:
                line = line.strip()
                if not line:
                    continue
                try:
                    chunk = json.loads(line)
                except Exception:
                    continue
                tok = chunk.get("message", {}).get("content", "")
                if tok:
                    sys.stdout.write(tok)
                    sys.stdout.flush()
                if chunk.get("done"):
                    sys.stdout.write("\n")
                    break
    except Exception as e:
        print(f"\n[ERR]: {e}", file=sys.stderr)
        return 1
    return 0


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--boot", action="store_true", help="errores del boot actual")
    ap.add_argument("--service", "-u", help="logs de un service systemd")
    args = ap.parse_args()
    return ask(fetch_input(args))


if __name__ == "__main__":
    sys.exit(main())
