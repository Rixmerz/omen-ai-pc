#!/usr/bin/env python3
"""
ai-crash-autopsy — analiza últimos coredumps + LLM resume causa.
Uso: ai-crash-autopsy            # lista crashes recientes + analiza el último
     ai-crash-autopsy <N>        # analiza coredump por índice (0=más reciente)
"""
from __future__ import annotations
import json
import subprocess
import sys
import urllib.request

OLLAMA_URL = "http://127.0.0.1:11434/api/chat"
MODEL = "qwen2.5-coder:7b-instruct-q4_K_M"

SYSTEM = """Analizás un coredump report Linux. Markdown, máx 8 líneas. Español. Estructura:
- **Proceso / cuándo:** ...
- **Señal / causa probable:** SEGV, ABRT, OOM... interpretado humanamente.
- **Stack relevante:** 2-3 frames clave, no todo.
- **Acción sugerida:** comando concreto (reinstalar paquete, actualizar driver, abrir bug)."""


def run(cmd: list[str], timeout: int = 15) -> str:
    try:
        return subprocess.check_output(cmd, timeout=timeout, text=True, stderr=subprocess.STDOUT)
    except Exception as e:
        return f"[err: {e}]"


def list_crashes() -> list[list[str]]:
    out = run(["coredumpctl", "list", "--no-pager", "--no-legend"])
    if "[err" in out or not out.strip():
        return []
    rows = []
    for line in out.strip().splitlines():
        rows.append(line.split())
    return rows


def info_for(idx: int) -> str:
    # MATCH=PID requires a way; simpler: use journalctl -o cat from coredumpctl info
    rows = list_crashes()
    if not rows or idx >= len(rows):
        return "(sin coredumps)"
    # coredumpctl info <PID o COREDUMP> - usar la N-ésima fila más reciente
    # rows están en orden ascendente (más viejo primero); idx 0 = más reciente
    sel = rows[-(idx + 1)] if idx < len(rows) else rows[0]
    # Buscar PID en columna habitual (4) o intentar varias
    pid = None
    for tok in sel:
        if tok.isdigit() and len(tok) >= 3:
            pid = tok
            break
    if not pid:
        return "(no se identificó PID)"
    return run(["coredumpctl", "info", pid])


def ask(text: str) -> int:
    body = {
        "model": MODEL,
        "messages": [{"role": "system", "content": SYSTEM}, {"role": "user", "content": text[-16000:]}],
        "stream": True,
        "options": {"temperature": 0.2, "num_ctx": 8192},
    }
    req = urllib.request.Request(OLLAMA_URL, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=180) as r:
            for line in r:
                line = line.strip()
                if not line:
                    continue
                try:
                    chunk = json.loads(line)
                except Exception:
                    continue
                tok = chunk.get("message", {}).get("content", "")
                if tok:
                    sys.stdout.write(tok)
                    sys.stdout.flush()
                if chunk.get("done"):
                    sys.stdout.write("\n")
                    break
    except Exception as e:
        print(f"\n[ERR]: {e}", file=sys.stderr)
        return 1
    return 0


def main() -> int:
    rows = list_crashes()
    if not rows:
        print("Sin coredumps registrados (coredumpctl ausente o vacío).")
        return 0
    print(f"Coredumps disponibles: {len(rows)}")
    for i, r in enumerate(rows[-5:][::-1]):
        print(f"  [{i}] {' '.join(r[:6])}")
    idx = int(sys.argv[1]) if len(sys.argv) > 1 else 0
    info = info_for(idx)
    print(f"\n--- Análisis crash idx {idx} ---")
    return ask(info)


if __name__ == "__main__":
    sys.exit(main())
