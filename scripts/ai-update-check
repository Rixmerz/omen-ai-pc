#!/usr/bin/env python3
"""
ai-update-check — pre 'pacman -Syu': resume updates + scanea arch news
por cambios breaking que afecten los paquetes pendientes.
"""
from __future__ import annotations
import json
import re
import subprocess
import sys
import urllib.request

NEWS_URL = "https://archlinux.org/feeds/news/"
OLLAMA_URL = "http://127.0.0.1:11434/api/chat"
MODEL = "qwen2.5-coder:7b-instruct-q4_K_M"


def fetch_news() -> list[str]:
    try:
        with urllib.request.urlopen(NEWS_URL, timeout=20) as r:
            xml = r.read().decode("utf-8", errors="replace")
    except Exception as e:
        return [f"[fetch err: {e}]"]
    items = re.findall(r"<item>(.*?)</item>", xml, re.S)
    out = []
    for it in items[:8]:
        title = re.search(r"<title>(.*?)</title>", it, re.S)
        desc = re.search(r"<description>(.*?)</description>", it, re.S)
        t = (title.group(1) if title else "").strip()
        d = (desc.group(1) if desc else "").strip()
        d = re.sub(r"<[^>]+>", " ", d)
        d = re.sub(r"\s+", " ", d)[:400]
        if t:
            out.append(f"## {t}\n{d}")
    return out


def pending_updates() -> list[str]:
    r = subprocess.run(["checkupdates"], capture_output=True, text=True, timeout=120)
    if r.returncode == 0:
        return [l for l in r.stdout.splitlines() if l.strip()]
    # fallback: requires pacman -Sy (root). Skip — checkupdates suficiente.
    return []


SYSTEM = """Analizás pre-actualización de Arch Linux. Te paso:
1. Lista de paquetes pendientes (pacman -Qu).
2. Noticias recientes de archlinux.org.

Output Markdown, máx 12 líneas, español:
- **Updates pendientes:** total + 3-5 más relevantes.
- **Noticias breaking que aplican:** intersección concreta de paquetes pendientes con news que recomienda intervención manual.
- **Riesgo:** bajo/medio/alto + razón.
- **Acción sugerida:** comando exacto o pasos."""


def main() -> int:
    print("Consultando updates...", file=sys.stderr)
    updates = pending_updates()
    print(f"  {len(updates)} pendientes", file=sys.stderr)
    print("Fetching arch news...", file=sys.stderr)
    news = fetch_news()
    print(f"  {len(news)} items", file=sys.stderr)
    if not updates and len(news) == 1 and news[0].startswith("[fetch"):
        print("Sin updates y news inaccesibles. Nada que hacer.")
        return 0

    user = "Updates pendientes:\n" + "\n".join(updates[:50]) + "\n\nNoticias:\n" + "\n\n".join(news)
    body = {
        "model": MODEL,
        "messages": [{"role": "system", "content": SYSTEM}, {"role": "user", "content": user[:14000]}],
        "stream": True,
        "options": {"temperature": 0.2, "num_ctx": 8192},
    }
    req = urllib.request.Request(OLLAMA_URL, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=240) as r:
            for line in r:
                line = line.strip()
                if not line:
                    continue
                try:
                    ch = json.loads(line)
                except Exception:
                    continue
                t = ch.get("message", {}).get("content", "")
                if t:
                    sys.stdout.write(t); sys.stdout.flush()
                if ch.get("done"):
                    sys.stdout.write("\n"); break
    except Exception as e:
        print(f"\n[ERR]: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
