#!/usr/bin/env python3
"""
system-ai-watch-journal — sigue journalctl -p err, dispara observer
en burst de errores. Cooldown evita spam.
"""
from __future__ import annotations
import json
import subprocess
import sys
import time
from collections import deque
from pathlib import Path

WINDOW_SEC = 60
BURST_THRESHOLD = 5
COOLDOWN_SEC = 300
OBSERVER = str(Path.home() / ".local/bin/system-ai-observer")
LOG = Path.home() / ".local/state/system-ai-watch.log"
LOG.parent.mkdir(parents=True, exist_ok=True)

# Ruido conocido: ignorar matches sustring (lowercase)
NOISE = (
    "tracker-miner",
    "geoclue",
    "bluetoothd",  # discovery spam
)


def loginfo(msg: str) -> None:
    with LOG.open("a") as f:
        f.write(f"{int(time.time())} {msg}\n")


def main() -> int:
    cmd = [
        "journalctl", "-f", "-p", "err",
        "--since", "now", "-o", "json", "--no-tail",
    ]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, bufsize=1)
    assert proc.stdout is not None

    times: deque[float] = deque()
    last_trigger = 0.0
    loginfo("started")

    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except Exception:
            continue
        msg = (ev.get("MESSAGE") or "").lower()
        unit = (ev.get("_SYSTEMD_UNIT") or ev.get("SYSLOG_IDENTIFIER") or "").lower()
        if any(n in msg or n in unit for n in NOISE):
            continue

        now = time.time()
        times.append(now)
        while times and now - times[0] > WINDOW_SEC:
            times.popleft()

        if len(times) >= BURST_THRESHOLD and (now - last_trigger) > COOLDOWN_SEC:
            last_trigger = now
            loginfo(f"burst {len(times)} errs/{WINDOW_SEC}s -> trigger observer")
            try:
                subprocess.Popen([OBSERVER], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                loginfo(f"trigger fail: {e}")
            times.clear()

    return proc.wait()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
